# ─── MongoDB ────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/brightfuture

# ─── Auth.js v5 ─────────────────────────────────────────────────────────────
# IMPORTANT: Auth.js v5 uses AUTH_SECRET (not NEXTAUTH_SECRET) and
# AUTH_URL (not NEXTAUTH_URL). Using the old names will silently break login.
#
# Generate AUTH_SECRET with one of these commands:
#   npx auth secret
#   openssl rand -base64 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=replace-with-output-of-npx-auth-secret

# Required in production (Vercel). In local dev, Next.js infers this automatically.
AUTH_URL=http://localhost:3000

# Required in production when running behind a proxy / on Vercel.
AUTH_TRUST_HOST=true

# ─── Cloudinary ─────────────────────────────────────────────────────────────
# Required for gallery image uploads and faculty/student photo uploads.
# Sign up free at https://cloudinary.com → Dashboard → Copy your credentials.
# Without these, all image uploads will return a 503 error.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ─── Razorpay ───────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# ─── Seed ───────────────────────────────────────────────────────────────────
# Optional: protects GET /api/seed. Leave blank to allow freely in dev.
SEED_SECRET=
